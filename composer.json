{
    "name": "edulazaro/wiretables",
    "description": "Tables for Laravel, Livewire and Alpine: Blade components that read the same on a phone and a desktop, header sorting and a row actions menu. Pure CSS, themed with the wire* family.",
    "keywords": [
        "laravel",
        "livewire",
        "alpine",
        "table",
        "datatable",
        "blade",
        "ui"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "illuminate/support": ">=11.0",
        "illuminate/view": ">=11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Header sorting through the WithSorting trait.",
        "alpinejs/alpine": "The row menu (x-wiretable.menu) uses Alpine with its anchor plugin, both bundled with Livewire."
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\Wiretables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduLazaro\\Wiretables\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Edu Lazaro",
            "email": "edu@edulazaro.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\Wiretables\\WiretablesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
